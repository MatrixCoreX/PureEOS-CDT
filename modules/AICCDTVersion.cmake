file(READ "${CMAKE_CURRENT_LIST_DIR}/../VERSION" AIC_CDT_VERSION)
string(STRIP "${AIC_CDT_VERSION}" AIC_CDT_VERSION)
if(NOT AIC_CDT_VERSION MATCHES "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$")
   message(FATAL_ERROR "AIC CDT VERSION must contain major.minor.patch")
endif()
set(VERSION_MAJOR "${CMAKE_MATCH_1}")
set(VERSION_MINOR "${CMAKE_MATCH_2}")
set(VERSION_PATCH "${CMAKE_MATCH_3}")
set(VERSION_SUFFIX "")
set(VERSION_FULL "${AIC_CDT_VERSION}")
